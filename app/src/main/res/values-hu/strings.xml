    <!-- Súgó -->
    <string name="help_menu_title">Számmenü</string>
    <string name="help_menu_body">Minden szám jobb oldalán a ⋮ terület nyitja meg a szám műveleteit. A teljes terület koppintható, és sosem indít lejátszást.</string>
    <string name="help_skip_title">Ugrógombok</string>
    <string name="help_skip_body">A csúszka alatti −/+ gombok az aktuális számon belül ugranak. Mindig látszanak, a minilejátszóban is. A lépést irányonként a Beállításokban adhatod meg.</string>
    <string name="help_queue_title">Várólista</string>
    <string name="help_queue_body">A várólistát a lejátszóból nyithatod meg. A fogantyút húzva átrendezheted, koppintásra az adott szám szól, a menüből eltávolíthatod. A „Lejátszás következőként” keverés közben is a soron következő helyre teszi a számot.</string>
    <string name="help_playlists_title">Listák és kedvencek</string>
    <string name="help_playlists_body">Számot, albumot vagy mappát a menüjéből adhatsz listához. A listából eltávolított szám fájlja nem törlődik.</string>
    <string name="help_folders_title">Mappák</string>
    <string name="help_folders_body">Elrejtheted a mappákat, amelyeket nem akarsz a zenetárban látni (pl. csengőhangok). A Beállításokban újra láthatóvá teheted őket.</string>
    <string name="help_headset_title">Fejhallgató</string>
    <string name="help_headset_body">A fejhallgató kihúzásakor vagy a Bluetooth megszakadásakor a zene szünetel. Visszacsatlakozáskor csak akkor folytatódik, ha ezt a Beállításokban bekapcsolod.</string>
