    <!-- Help -->
    <string name="help_menu_title">Track menu</string>
    <string name="help_menu_body">The ⋮ area on the right of every track opens the track’s actions. The whole area is tappable and never starts playback.</string>
    <string name="help_skip_title">Skip buttons</string>
    <string name="help_skip_body">The −/+ buttons below the progress bar jump within the current track. They are always visible, also in the mini player. Set the step for each direction in Settings.</string>
    <string name="help_queue_title">Queue</string>
    <string name="help_queue_body">Open the queue from the player. Drag the handle to reorder, tap a track to play it, or remove it from its menu. “Play next” puts tracks right after the current one, even when shuffling.</string>
    <string name="help_playlists_title">Playlists and favorites</string>
    <string name="help_playlists_body">Add tracks, albums or folders to a playlist from their menus. Removing a track from a playlist never deletes the file.</string>
    <string name="help_folders_title">Folders</string>
    <string name="help_folders_body">Hide folders you don’t want in the library (for example ringtones). You can show them again in Settings.</string>
    <string name="help_headset_title">Headphones</string>
    <string name="help_headset_body">Music pauses when headphones are unplugged or Bluetooth disconnects. It only resumes on reconnect if you turn that on in Settings.</string>
